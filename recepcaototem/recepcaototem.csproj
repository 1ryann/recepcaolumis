<Project Sdk="Microsoft.NET.Sdk.Web">
<PropertyGroup>
<TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<UserSecretsId>aspnet-recepcaototem-0d5d7097-983f-4449-9f40-9f998d90c348</UserSecretsId>
<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
<ScopedCssEnabled>false</ScopedCssEnabled>
</PropertyGroup>
<ItemGroup>
<ProjectReference Include="../src/GestaoPredio.Infrastructure/GestaoPredio.Infrastructure.csproj" />
<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11"><PrivateAssets>all</PrivateAssets></PackageReference>
</ItemGroup>
<ItemGroup>
<Content Remove="ClientApp/**;wwwroot/**;Pages/**;Areas/**" />
<None Remove="ClientApp/**;wwwroot/**" />
</ItemGroup>
<Target Name="BuildClientApp" BeforeTargets="ComputeFilesToPublish">
  <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm ci" />
  <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm run build" />
  <ItemGroup>
    <ClientAppDist Include="$(MSBuildProjectDirectory)/ClientApp/dist/**" Exclude="$(MSBuildProjectDirectory)/ClientApp/dist/**/*.map" />
    <ResolvedFileToPublish Include="@(ClientAppDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
      <RelativePath>wwwroot/%(ClientAppDist.RecursiveDir)%(ClientAppDist.Filename)%(ClientAppDist.Extension)</RelativePath>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ResolvedFileToPublish>
  </ItemGroup>
</Target>
</Project>
